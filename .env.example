# Copy to .env and edit. Every value below has a working default.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Hashed static filenames for far-future caching. Defaults to the opposite of
# DJANGO_DEBUG. Whatever you set here, `collectstatic` and the web server must
# both see the same value -- keep it in this file and they will.
# DJANGO_HASHED_STATIC=True

# Leave unset for SQLite. Examples:
#   postgres://user:password@localhost:5432/dental
#   mysql://user:password@localhost:3306/dental
# DATABASE_URL=

# --- AI assistant -----------------------------------------------------------
# Without a key the app runs on the built-in rule-based dental engine.
# With a key it uses the Gemini API and keeps the rule engine as a fallback.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_MAX_TOKENS=2000
AI_EFFORT=low
AI_ENABLED=True
AI_RATE_LIMIT=30/min
# Blank derives the thinking budget from AI_EFFORT. 0 disables thinking
# (fastest, cheapest); -1 lets the model decide how much to think.
# AI_THINKING_BUDGET=

# --- Clinic branding --------------------------------------------------------
CLINIC_NAME=SmileCare Dental Clinic
CLINIC_PHONE=+91 98765 43210
CLINIC_ADDRESS=12 MG Road, Pune, Maharashtra 411001
CLINIC_EMERGENCY_NUMBER=+91 98765 43211

# --- Email (reminders) ------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@smiledental.example
